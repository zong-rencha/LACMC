ARG SOURCE_IMAGE=lacmc-qmix:1.3
FROM ${SOURCE_IMAGE} AS environment

FROM python:3.10.19-slim-bookworm@sha256:23f63358922e79a794f71be8f3723c84e5ccca9638af3f74456dc73d6184499e
COPY --from=environment /usr/local/ /usr/local/
COPY --from=environment /usr/lib/ /usr/lib/
COPY --from=environment /etc/ssl/certs/ /etc/ssl/certs/
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app:/app/src \
    LACMC_SC2_ONLY=1 \
    GIT_PYTHON_REFRESH=quiet \
    MPLBACKEND=Agg \
    OMP_NUM_THREADS=2 \
    MKL_NUM_THREADS=2 \
    OPENBLAS_NUM_THREADS=2 \
    LACMC_TORCH_THREADS=2 \
    SC2PATH=/opt/StarCraftII
COPY runtime/src/ /app/src/
COPY licenses/ /app/licenses/
WORKDIR /app/src
RUN python -m pip freeze > /app/requirements-resolved.txt
CMD ["python", "-u", "evaluate3.py"]
